#include <winver.h>

1 VERSIONINFO
FILEVERSION @RMD_VERSION_MAJOR@,@RMD_VERSION_MINOR@,0,0
PRODUCTVERSION @RMD_VERSION_MAJOR@,@RMD_VERSION_MINOR@,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "RinMotionDance\0"
            VALUE "FileVersion", "@RMD_VERSION@\0"
            VALUE "InternalName", "RinMotionDance\0"
            VALUE "OriginalFilename", "RinMotionDance.exe\0"
            VALUE "ProductName", "RinMotionDance\0"
            VALUE "ProductVersion", "@RMD_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
