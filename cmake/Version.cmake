set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/VERSION")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/VERSION" RMD_VERSION)
string(STRIP "${RMD_VERSION}" RMD_VERSION)
if(NOT RMD_VERSION MATCHES "^([1-9][0-9]*)[.]([0-9][0-9])$")
    message(FATAL_ERROR "VERSION must have the form 10.00 (major.two-digit-minor)")
endif()
set(RMD_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(RMD_VERSION_MINOR "${CMAKE_MATCH_2}")
string(REGEX REPLACE "^0+" "" RMD_VERSION_MINOR "${RMD_VERSION_MINOR}")
if(RMD_VERSION_MINOR STREQUAL "")
    set(RMD_VERSION_MINOR 0)
endif()
if(RMD_VERSION_MAJOR GREATER 65535)
    message(FATAL_ERROR "VERSION major exceeds the Windows version-resource limit")
endif()
